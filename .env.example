# NyumbaFlow environment variables
# Copy this file to .env and fill in real values before going to production.

# --- Core ---
# PostgreSQL connection string. NyumbaFlow requires a real Postgres database —
# it will not run without one (see src/lib/db.ts for why: this app targets
# serverless hosts like Vercel, which have no persistent local disk, so a
# file-based database like SQLite cannot hold real data there).
#
# Any managed Postgres works: Neon (https://neon.tech, has a generous free
# tier and a one-click Vercel integration), Vercel Postgres, Supabase,
# Railway, or your own instance. Tables are created automatically on first
# request (see ensureSchema() in src/lib/db.ts) — no separate migration step.
DATABASE_URL=postgresql://user:password@host:5432/nyumbaflow

# Secret used to sign session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# --- IntaSend (the ONLY payment processor used in this app) ---
# Get these from your IntaSend dashboard: Settings -> API Keys
# https://intasend.com
INTASEND_PUBLISHABLE_KEY=ISPubKey_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
INTASEND_SECRET_KEY=ISSecretKey_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# "sandbox" (default) or "live"
INTASEND_ENV=sandbox

# Set the same string in your IntaSend dashboard under Settings -> Webhooks,
# and point the webhook URL to https://yourdomain.com/api/webhooks/intasend
INTASEND_WEBHOOK_CHALLENGE=change-me-too

# --- SMS / WhatsApp (OTP + rent reminders) ---
# Left unset, messages are logged to the server console (see src/lib/sms.ts)
# so the app runs end-to-end without a real SMS account.
#
# Option A: Africa's Talking (recommended for Kenya/EA — set SMS_PROVIDER=africastalking)
# SMS_PROVIDER=africastalking
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_USERNAME=          # use "sandbox" for their test environment
# AFRICASTALKING_SENDER_ID=         # optional shortcode/alphanumeric sender ID
#
# Option B: Twilio (set SMS_PROVIDER=twilio)
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- Scheduled jobs (monthly invoices + rent reminders) ---
# Triggered by an EXTERNAL scheduler (Vercel Cron, GitHub Actions, etc.)
# hitting /api/cron/generate-invoices and /api/cron/send-reminders — see the
# README's "Scheduled jobs" section. Required in all deployments; there is no
# in-process scheduler (serverless function instances are too short-lived and
# too easily multiplied for an in-process timer to be reliable).
CRON_SECRET=change-me-too

# --- File storage ---
# "local" (default) saves to public/uploads. Set to "s3" for production/serverless.
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL_BASE=               # e.g. https://your-bucket.s3.amazonaws.com
